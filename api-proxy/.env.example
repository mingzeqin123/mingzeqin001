# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRATION=1h

# Database (optional, for storing API configurations)
# DATABASE_URL=mongodb://localhost:27017/apiproxy

# External API Keys (examples)
# GITHUB_TOKEN=your-github-token
# GOOGLE_API_KEY=your-google-api-key
# OPENAI_API_KEY=your-openai-api-key

# Logging
LOG_LEVEL=info

# Security
ENABLE_CORS=true
ENABLE_HELMET=true
ENABLE_RATE_LIMIT=true

# gRPC Configuration
GRPC_HOST=localhost
GRPC_PORT=50051