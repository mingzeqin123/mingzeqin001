# AI评论分类器环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置

# ================================
# 服务器配置
# ================================
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DEBUG_MODE=True

# ================================
# 分类器基本配置
# ================================
# 批量处理最大数量
MAX_BATCH_SIZE=100

# 重复评论相似度阈值 (0-1)
SIMILARITY_THRESHOLD=0.8

# 历史评论保存数量
HISTORY_SIZE=100

# ================================
# 分类置信度阈值
# ================================
# 广告评论置信度阈值
AD_CONFIDENCE_THRESHOLD=0.5

# 灌水评论置信度阈值
SPAM_CONFIDENCE_THRESHOLD=0.4

# 无意义评论置信度阈值
MEANINGLESS_CONFIDENCE_THRESHOLD=0.5

# ================================
# 特征权重配置
# ================================
# 联系方式权重
CONTACT_WEIGHT=0.4

# 网址链接权重
URL_WEIGHT=0.3

# 短长度权重
SHORT_LENGTH_WEIGHT=0.3

# 重复字符权重
REPEAT_WEIGHT=0.2

# 关键词权重
KEYWORD_WEIGHT=0.1

# 标点符号权重
PUNCTUATION_WEIGHT=0.2

# ================================
# 文本特征阈值
# ================================
# 最小评论长度
MIN_COMMENT_LENGTH=5

# 最小词汇数量
MIN_WORD_COUNT=2

# 最大标点符号比例
MAX_PUNCTUATION_RATIO=0.3

# 最大数字比例
MAX_NUMBER_RATIO=0.8

# 最大英文比例
MAX_ENGLISH_RATIO=0.8

# ================================
# 日志配置
# ================================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日志格式
LOG_FORMAT=%(asctime)s - %(levelname)s - %(message)s

# ================================
# 自定义关键词配置
# ================================
# 是否启用自定义关键词
ENABLE_CUSTOM_KEYWORDS=True

# 自定义关键词文件路径
CUSTOM_KEYWORDS_FILE=custom_keywords.json

# ================================
# 数据库配置 (可选)
# ================================
# DATABASE_URL=sqlite:///comments.db
# REDIS_URL=redis://localhost:6379/0

# ================================
# 缓存配置 (可选)
# ================================
# CACHE_TYPE=simple
# CACHE_DEFAULT_TIMEOUT=300

# ================================
# 安全配置 (可选)
# ================================
# SECRET_KEY=your-secret-key-here
# API_KEY=your-api-key-here

# ================================
# 监控配置 (可选)
# ================================
# ENABLE_METRICS=True
# METRICS_PORT=9090