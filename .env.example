# 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# 基本配置
APP_ENV=production
LOG_LEVEL=info
DEBUG=false

# 服务配置
SERVICE_NAME=app-service
SERVICE_PORT=8080
HEALTH_CHECK_URL=http://localhost:8080/health

# 部署配置
DEPLOY_DIR=/opt/app
BACKUP_DIR=/opt/app/backups
BUILD_SCHEDULE="0 2 * * *"

# Git配置
GIT_REPO_URL=https://github.com/your-username/your-repo.git
GIT_BRANCH=main
SYNC_INTERVAL=3600

# Docker配置
DOCKER_REGISTRY=your-registry.com
IMAGE_NAME=jump-jump-game

# 通知配置
WEBHOOK_URL=
ALERT_WEBHOOK_URL=
REPORT_WEBHOOK_URL=
SLACK_WEBHOOK=

# 数据库配置（如果需要）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=

# 监控配置
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# 安全配置
JWT_SECRET=your-jwt-secret
API_KEY=your-api-key

# 第三方服务配置
WECHAT_APP_ID=wx1234567890abcdef
WECHAT_APP_SECRET=

# 文件存储配置
STORAGE_PATH=/opt/app/storage
UPLOAD_MAX_SIZE=10MB

# 缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 邮件配置
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=