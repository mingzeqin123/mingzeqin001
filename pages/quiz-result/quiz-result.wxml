<!--quiz-result.wxml-->
<view class="result-container">
  <!-- 结果概览 -->
  <view wx:if="{{result}}" class="result-summary">
    <view class="summary-header">
      <text class="summary-title">答题结果</text>
      <view class="score-display">
        <text class="score">{{result.score}}</text>
        <text class="score-unit">分</text>
      </view>
    </view>
    
    <view class="summary-stats">
      <view class="stat-item">
        <text class="stat-value">{{result.totalQuestions}}</text>
        <text class="stat-label">总题数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value correct">{{result.correctAnswers}}</text>
        <text class="stat-label">正确</text>
      </view>
      <view class="stat-item">
        <text class="stat-value wrong">{{result.wrongAnswers}}</text>
        <text class="stat-label">错误</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{result.accuracy}}%</text>
        <text class="stat-label">正确率</text>
      </view>
    </view>
  </view>

  <!-- 答题详情 -->
  <view class="answer-details">
    <view class="details-header">
      <text class="details-title">答题详情</text>
    </view>
    
    <view wx:for="{{userAnswers}}" wx:key="questionId" class="answer-item">
      <view wx:for-item="answer" wx:for-index="answerIndex">
        <view wx:for="{{questions}}" wx:key="id" wx:if="{{item.id === answer.questionId}}">
          <view class="question-card {{answer.isCorrect ? 'correct' : 'wrong'}}">
            <!-- 题目头部 -->
            <view class="question-header">
              <view class="question-info">
                <text class="question-type">{{questionTypeMap[item.type]}}</text>
                <text class="question-number">第{{answerIndex + 1}}题</text>
              </view>
              <view class="result-icon">
                <text wx:if="{{answer.isCorrect}}" class="icon-correct">✓</text>
                <text wx:else class="icon-wrong">✗</text>
              </view>
            </view>
            
            <!-- 题目内容 -->
            <view class="question-content">
              <text class="question-text">{{item.question}}</text>
            </view>
            
            <!-- 选项列表 -->
            <view class="options-display">
              <view wx:for="{{item.options}}" wx:key="optionIndex" wx:for-item="option" wx:for-index="optionIndex" 
                    class="option-display">
                <view class="option-item 
                      {{(item.type === 'multiple' && answer.userAnswer.indexOf(optionIndex) > -1) || 
                        (item.type !== 'multiple' && answer.userAnswer === optionIndex) ? 'user-selected' : ''}}
                      {{(item.type === 'multiple' && item.correctAnswer.indexOf(optionIndex) > -1) || 
                        (item.type !== 'multiple' && item.correctAnswer === optionIndex) ? 'correct-answer' : ''}}">
                  <text class="option-label">{{String.fromCharCode(65 + optionIndex)}}.</text>
                  <text class="option-text">{{option}}</text>
                  
                  <!-- 标记图标 -->
                  <view class="option-icons">
                    <!-- 用户选择标记 -->
                    <text wx:if="{{(item.type === 'multiple' && answer.userAnswer.indexOf(optionIndex) > -1) || 
                                   (item.type !== 'multiple' && answer.userAnswer === optionIndex)}}" 
                          class="user-choice-icon">你选</text>
                    
                    <!-- 正确答案标记 -->
                    <text wx:if="{{(item.type === 'multiple' && item.correctAnswer.indexOf(optionIndex) > -1) || 
                                   (item.type !== 'multiple' && item.correctAnswer === optionIndex)}}" 
                          class="correct-icon">正确</text>
                  </view>
                </view>
              </view>
            </view>
            
            <!-- 答案解析 -->
            <view class="explanation">
              <view class="explanation-header">
                <text class="explanation-title">答案解析</text>
              </view>
              <text class="explanation-text">{{item.explanation}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="action-btn primary" bindtap="retakeQuiz">重新答题</button>
    <button class="action-btn" bindtap="goHome">返回首页</button>
  </view>
</view>