/* quiz-history.wxss */
.history-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
}

/* 页面头部 */
.header {
  text-align: center;
  padding: 40rpx 20rpx 60rpx;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
}

.header-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.empty-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
}

.empty-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 60rpx;
}

.start-quiz-btn {
  background: linear-gradient(45deg, #ff6b6b, #ee5a24);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 80rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.3);
}

/* 历史记录列表 */
.history-list {
  margin-bottom: 40rpx;
}

.action-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}

.clear-btn, .new-quiz-btn {
  padding: 16rpx 32rpx;
  border-radius: 25rpx;
  font-size: 26rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.1);
  color: white;
}

.new-quiz-btn {
  background: rgba(255, 255, 255, 0.2);
}

/* 历史记录项 */
.history-item {
  background: white;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

.item-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.item-left {
  display: flex;
  align-items: center;
}

.score-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.3);
}

.score-text {
  font-size: 24rpx;
  font-weight: bold;
  color: white;
}

.item-info {
  display: flex;
  flex-direction: column;
}

.item-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.item-time {
  font-size: 24rpx;
  color: #666;
}

.item-right {
  display: flex;
  align-items: center;
  position: relative;
}

.stats {
  margin-right: 20rpx;
}

.stat-row {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
  font-size: 22rpx;
}

.stat-row:last-child {
  margin-bottom: 0;
}

.stat-label {
  color: #666;
  min-width: 80rpx;
}

.stat-value {
  font-weight: bold;
  color: #333;
}

.stat-value.correct {
  color: #28a745;
}

.stat-value.wrong {
  color: #dc3545;
}

.delete-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(220, 53, 69, 0.1);
}

.delete-icon {
  font-size: 24rpx;
}

/* 成绩等级标识 */
.grade-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
}

.grade {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: bold;
  color: white;
}

.grade.excellent {
  background: linear-gradient(45deg, #28a745, #20c997);
}

.grade.good {
  background: linear-gradient(45deg, #17a2b8, #6f42c1);
}

.grade.fair {
  background: linear-gradient(45deg, #ffc107, #fd7e14);
}

.grade.pass {
  background: linear-gradient(45deg, #6c757d, #495057);
}

.grade.fail {
  background: linear-gradient(45deg, #dc3545, #c82333);
}

/* 底部操作 */
.bottom-actions {
  padding: 20rpx 0;
  text-align: center;
}

.action-btn {
  background: rgba(255, 255, 255, 0.2);
  color: white;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  padding: 16rpx 60rpx;
  font-size: 28rpx;
}