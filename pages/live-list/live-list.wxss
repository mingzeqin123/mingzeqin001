/* 直播列表页面样式 */
.live-list-container {
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}

/* 搜索栏 */
.search-bar {
  background: #fff;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 30rpx;
  padding: 0 20rpx;
}

.search-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  border: none;
  background: transparent;
}

.search-btn {
  width: 100rpx;
  height: 60rpx;
  background: #ff4757;
  color: #fff;
  border: none;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-left: 10rpx;
}

.clear-btn {
  width: 80rpx;
  height: 60rpx;
  background: #e9ecef;
  color: #666;
  border: none;
  border-radius: 30rpx;
  font-size: 24rpx;
}

/* 筛选栏 */
.filter-bar {
  background: #fff;
  padding: 20rpx;
  display: flex;
  gap: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.filter-item {
  flex: 1;
}

.picker-text {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx 20rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #333;
}

.arrow {
  font-size: 20rpx;
  color: #999;
}

/* 直播列表 */
.live-list {
  flex: 1;
  padding: 20rpx;
}

.live-item {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
  transition: transform 0.3s;
}

.live-item:active {
  transform: scale(0.98);
}

/* 直播封面 */
.live-cover {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.live-status {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
}

.viewer-count {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.live-duration {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* 直播信息 */
.live-info {
  padding: 20rpx;
}

.live-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.host-info {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.host-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.host-name {
  font-size: 26rpx;
  color: #666;
  margin-right: 10rpx;
}

.host-level {
  background: #ff4757;
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 15rpx;
  font-size: 20rpx;
}

.live-stats {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  font-size: 24rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.start-live-btn {
  background: #ff4757;
  color: #fff;
  border: none;
  border-radius: 30rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  z-index: 100;
}

.fab-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #ff4757;
  color: #fff;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(255,71,87,0.4);
  transition: transform 0.3s;
}

.fab-btn:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 40rpx;
  margin-bottom: 5rpx;
}

.fab-text {
  font-size: 20rpx;
}

/* 响应式适配 */
@media screen and (max-width: 750rpx) {
  .live-cover {
    height: 350rpx;
  }
  
  .live-title {
    font-size: 28rpx;
  }
  
  .host-name {
    font-size: 24rpx;
  }
}