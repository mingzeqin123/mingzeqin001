/* todolist.wxss */
.container {
  padding: 20rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

/* 头部样式 */
.header {
  text-align: center;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: -20rpx -20rpx 30rpx -20rpx;
  color: white;
  border-radius: 0 0 30rpx 30rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.8;
}

/* 添加任务区域 */
.add-section {
  margin-bottom: 40rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 25rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.task-input {
  flex: 1;
  font-size: 32rpx;
  border: none;
  outline: none;
}

.add-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  margin-left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0;
}

.add-btn[disabled] {
  background: #e0e0e0;
  color: #999;
}

.add-icon {
  font-size: 40rpx;
  font-weight: bold;
}

/* 任务列表 */
.task-list {
  margin-top: 20rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.clear-btn {
  background: #ff6b6b;
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 10rpx 25rpx;
  font-size: 24rpx;
}

/* 任务项 */
.task-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  margin-bottom: 15rpx;
  border-radius: 20rpx;
  padding: 30rpx 25rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.completed-item {
  opacity: 0.7;
  background: #f8f9fa;
}

.task-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #ddd;
  border-radius: 50%;
  margin-right: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.checkbox.checked {
  background: #4caf50;
  border-color: #4caf50;
}

.check-icon {
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

.task-text {
  font-size: 32rpx;
  color: #333;
  flex: 1;
  word-break: break-word;
}

.task-text.completed {
  text-decoration: line-through;
  color: #999;
}

.task-actions {
  display: flex;
  gap: 15rpx;
}

.edit-btn, .delete-btn {
  padding: 10rpx 20rpx;
  border-radius: 15rpx;
  font-size: 24rpx;
  border: none;
}

.edit-btn {
  background: #2196f3;
  color: white;
}

.delete-btn {
  background: #ff6b6b;
  color: white;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 50rpx;
  color: #999;
}

.empty-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 36rpx;
  margin-bottom: 15rpx;
  color: #666;
}

.empty-subtitle {
  font-size: 28rpx;
  color: #999;
}

/* 编辑弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 600rpx;
  max-width: 90%;
  overflow: hidden;
}

.modal-header {
  padding: 40rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  padding: 30rpx;
}

.edit-input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  padding: 20rpx 30rpx 30rpx;
  gap: 20rpx;
}

.cancel-btn, .confirm-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 15rpx;
  font-size: 32rpx;
  border: none;
}

.cancel-btn {
  background: #f0f0f0;
  color: #666;
}

.confirm-btn {
  background: #4caf50;
  color: white;
}