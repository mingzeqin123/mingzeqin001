/* pages/chat/chat.wxss */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 顶部状态栏 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #e0e0e0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.room-info {
  display: flex;
  flex-direction: column;
}

.room-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.user-count {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-list-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: #007aff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.connection-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #ff3b30;
}

.connection-status.connected .status-dot {
  background-color: #34c759;
}

.status-text {
  font-size: 24rpx;
  color: #666;
}

/* 用户列表侧边栏 */
.user-list {
  position: fixed;
  top: 0;
  right: -400rpx;
  width: 400rpx;
  height: 100vh;
  background-color: #fff;
  box-shadow: -4rpx 0 12rpx rgba(0,0,0,0.1);
  transition: right 0.3s ease;
  z-index: 1000;
}

.user-list.show {
  right: 0;
}

.user-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.user-list-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
}

.user-list-content {
  height: calc(100vh - 120rpx);
  padding: 20rpx 0;
}

.user-item {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  gap: 20rpx;
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: #007aff;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.user-status {
  font-size: 24rpx;
  color: #34c759;
  margin-top: 4rpx;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.message-item {
  margin-bottom: 30rpx;
  display: flex;
}

.message-item.own-message {
  justify-content: flex-end;
}

.message-item.other-message {
  justify-content: flex-start;
}

.message-content {
  max-width: 70%;
  display: flex;
  flex-direction: column;
}

.message-header {
  margin-bottom: 8rpx;
}

.sender-name {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.message-bubble {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  position: relative;
}

.own-message .message-bubble {
  background-color: #007aff;
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.other-message .message-bubble {
  background-color: #fff;
  color: #333;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.message-text {
  font-size: 28rpx;
  line-height: 1.4;
  word-wrap: break-word;
}

.message-time {
  margin-top: 8rpx;
  text-align: right;
}

.own-message .message-time {
  text-align: right;
}

.other-message .message-time {
  text-align: left;
}

.message-time text {
  font-size: 20rpx;
  color: #999;
}

/* 正在输入提示 */
.typing-indicator {
  padding: 20rpx;
  text-align: center;
}

.typing-text {
  font-size: 24rpx;
  color: #666;
  font-style: italic;
}

/* 输入区域 */
.input-area {
  background-color: #fff;
  border-top: 1rpx solid #e0e0e0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.input-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background-color: #f8f8f8;
  border-radius: 40rpx;
  padding: 10rpx 20rpx;
}

.message-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  background-color: transparent;
  border: none;
  outline: none;
}

.send-btn {
  height: 60rpx;
  padding: 0 30rpx;
  border-radius: 30rpx;
  background-color: #e0e0e0;
  color: #999;
  border: none;
  font-size: 28rpx;
  transition: all 0.3s ease;
}

.send-btn.active {
  background-color: #007aff;
  color: #fff;
}

.send-btn:disabled {
  opacity: 0.5;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .message-content {
    max-width: 85%;
  }
  
  .user-list {
    width: 100%;
    right: -100%;
  }
}