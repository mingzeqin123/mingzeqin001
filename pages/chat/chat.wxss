/* pages/chat/chat.wxss */

.chat-container {
  height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  position: relative;
  overflow: hidden;
}

/* 加载状态 */
.loading-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 1000;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid #e0e0e0;
  border-top: 3px solid #007AFF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 10px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: #666;
  font-size: 14px;
}

/* 聊天头部 */
.chat-header {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  padding: 10px 15px;
  border-bottom: 1px solid #e0e0e0;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.room-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.room-name {
  font-size: 16px;
  font-weight: bold;
  color: #333;
}

.online-status {
  display: flex;
  align-items: center;
  gap: 5px;
}

.online-count {
  font-size: 12px;
  color: #666;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ccc;
}

.status-dot.connected {
  background: #4CAF50;
  animation: pulse 2s infinite;
}

.status-dot.disconnected {
  background: #f44336;
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.5; }
  100% { opacity: 1; }
}

/* 正在输入提示 */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 5px;
  padding: 5px 10px;
  background: rgba(0, 122, 255, 0.1);
  border-radius: 15px;
}

.typing-text {
  font-size: 12px;
  color: #007AFF;
}

.typing-dots {
  display: flex;
  gap: 2px;
}

.typing-dots .dot {
  width: 4px;
  height: 4px;
  background: #007AFF;
  border-radius: 50%;
  animation: typing 1.4s infinite ease-in-out;
}

.typing-dots .dot:nth-child(1) { animation-delay: -0.32s; }
.typing-dots .dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes typing {
  0%, 80%, 100% { 
    opacity: 0.3;
    transform: scale(0.8);
  }
  40% { 
    opacity: 1;
    transform: scale(1);
  }
}

/* 消息列表 */
.message-list {
  position: fixed;
  top: 80px;
  left: 0;
  right: 0;
  bottom: 60px;
  padding: 10px;
  background: transparent;
}

.message-item {
  margin-bottom: 15px;
}

/* 系统消息 */
.system-message {
  text-align: center;
  margin: 10px 0;
}

.system-text {
  background: rgba(0, 0, 0, 0.1);
  color: #666;
  font-size: 12px;
  padding: 5px 12px;
  border-radius: 12px;
  display: inline-block;
}

/* 聊天消息 */
.chat-message {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  max-width: 85%;
  margin-bottom: 8px;
}

.chat-message.self {
  flex-direction: row-reverse;
  margin-left: auto;
  margin-right: 0;
}

.chat-message.other {
  margin-right: auto;
  margin-left: 0;
}

/* 头像 */
.avatar-container {
  flex-shrink: 0;
}

.avatar {
  width: 35px;
  height: 35px;
  border-radius: 50%;
  background: #e0e0e0;
}

/* 消息内容 */
.message-content {
  flex: 1;
  min-width: 0;
}

.username {
  font-size: 12px;
  color: #666;
  margin-bottom: 2px;
  padding-left: 10px;
}

/* 消息气泡 */
.message-bubble {
  padding: 10px 15px;
  border-radius: 18px;
  max-width: 100%;
  word-wrap: break-word;
  position: relative;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
}

.self-bubble {
  background: linear-gradient(135deg, #007AFF, #0051D5);
  color: white;
  margin-left: 20px;
}

.other-bubble {
  background: white;
  color: #333;
  margin-right: 20px;
  border: 1px solid #e0e0e0;
}

.message-text {
  font-size: 15px;
  line-height: 1.4;
  word-break: break-all;
}

/* 时间戳 */
.message-time {
  font-size: 10px;
  color: #999;
  margin-top: 2px;
  display: block;
}

.self-time {
  text-align: right;
  padding-right: 10px;
}

.other-time {
  text-align: left;
  padding-left: 10px;
}

.message-placeholder {
  height: 20px;
}

/* 输入区域 */
.input-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-top: 1px solid #e0e0e0;
  padding: 10px;
  z-index: 100;
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 10px;
}

.message-input {
  flex: 1;
  background: #f5f5f5;
  border: 1px solid #e0e0e0;
  border-radius: 25px;
  padding: 10px 15px;
  font-size: 15px;
  min-height: 20px;
  max-height: 80px;
}

.message-input:focus {
  border-color: #007AFF;
  background: white;
}

.send-button {
  background: #e0e0e0;
  color: #999;
  border: none;
  border-radius: 20px;
  padding: 10px 20px;
  font-size: 14px;
  font-weight: bold;
  transition: all 0.3s ease;
  min-width: 60px;
}

.send-button.active {
  background: #007AFF;
  color: white;
}

.send-button[disabled] {
  opacity: 0.5;
}

/* 功能按钮 */
.action-buttons {
  position: fixed;
  right: 15px;
  bottom: 80px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  z-index: 50;
}

.action-btn {
  width: 45px;
  height: 45px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border: 1px solid #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  padding: 0;
  font-size: 12px;
}

.btn-text {
  color: #007AFF;
  font-size: 10px;
  font-weight: bold;
}

.action-btn:active {
  background: rgba(0, 122, 255, 0.1);
}

/* 响应式设计 */
@media (max-width: 350px) {
  .chat-message {
    max-width: 90%;
  }
  
  .message-bubble {
    padding: 8px 12px;
  }
  
  .message-text {
    font-size: 14px;
  }
}

/* 暗黑模式适配 */
@media (prefers-color-scheme: dark) {
  .chat-container {
    background: linear-gradient(135deg, #1a1a1a 0%, #2d3748 100%);
  }
  
  .chat-header {
    background: rgba(45, 55, 72, 0.95);
    border-bottom-color: #4a5568;
  }
  
  .room-name {
    color: #e2e8f0;
  }
  
  .other-bubble {
    background: #2d3748;
    color: #e2e8f0;
    border-color: #4a5568;
  }
  
  .message-input {
    background: #2d3748;
    color: #e2e8f0;
    border-color: #4a5568;
  }
  
  .input-container {
    background: rgba(45, 55, 72, 0.95);
    border-top-color: #4a5568;
  }
}