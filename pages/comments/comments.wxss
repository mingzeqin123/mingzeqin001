/* pages/comments/comments.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 评论输入区域 */
.comment-input-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.char-count {
  font-size: 24rpx;
  color: #999;
}

.input-container {
  margin-bottom: 20rpx;
}

.comment-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background-color: #fafafa;
  box-sizing: border-box;
}

.comment-input:focus {
  border-color: #007aff;
  background-color: white;
}

/* 验证码区域 */
.captcha-section {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border: 1rpx solid #e9ecef;
}

.captcha-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.captcha-label {
  font-size: 28rpx;
  color: #333;
  white-space: nowrap;
}

.captcha-image {
  position: relative;
  width: 120rpx;
  height: 60rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: white;
}

.captcha-image image {
  width: 100%;
  height: 100%;
}

.refresh-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  font-size: 20rpx;
  text-align: center;
  padding: 4rpx;
}

.captcha-input {
  flex: 1;
  height: 60rpx;
  padding: 0 15rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  background-color: white;
}

/* 提交区域 */
.submit-section {
  position: relative;
}

.submit-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #007aff, #0056cc);
  color: white;
  border: none;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn.disabled {
  background: #ccc;
  color: #999;
}

.user-status {
  margin-top: 15rpx;
  padding: 15rpx;
  background-color: #fff3cd;
  border: 1rpx solid #ffeaa7;
  border-radius: 8rpx;
}

.blocked-message {
  font-size: 26rpx;
  color: #856404;
  text-align: center;
}

.cooldown-info {
  margin-top: 15rpx;
  padding: 15rpx;
  background-color: #d1ecf1;
  border: 1rpx solid #bee5eb;
  border-radius: 8rpx;
}

.cooldown-message {
  font-size: 26rpx;
  color: #0c5460;
  text-align: center;
}

/* 评论列表区域 */
.comments-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.filter-options {
  display: flex;
  align-items: center;
}

.picker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #666;
  padding: 10rpx 15rpx;
  background-color: #f8f9fa;
  border-radius: 20rpx;
  border: 1rpx solid #e9ecef;
}

.arrow {
  font-size: 20rpx;
  color: #999;
}

/* 评论项 */
.comment-item {
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 2rpx solid #f0f0f0;
}

.user-details {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.username {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-actions {
  display: flex;
  gap: 20rpx;
}

.like-btn {
  font-size: 24rpx;
  color: #666;
  padding: 8rpx 15rpx;
  background-color: #f8f9fa;
  border-radius: 20rpx;
  border: 1rpx solid #e9ecef;
}

.comment-content {
  margin-left: 75rpx;
}

.comment-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.comment-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  font-size: 20rpx;
  color: #007aff;
  background-color: #e3f2fd;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  border: 1rpx solid #bbdefb;
}

/* 管理员操作 */
.admin-actions {
  margin-top: 15rpx;
  margin-left: 75rpx;
  display: flex;
  gap: 15rpx;
}

.admin-btn {
  font-size: 24rpx;
  color: #dc3545;
  background-color: #f8d7da;
  border: 1rpx solid #f5c6cb;
  border-radius: 8rpx;
  padding: 8rpx 15rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #999;
  font-size: 28rpx;
}

.load-more {
  text-align: center;
  margin-top: 30rpx;
}

.load-more-btn {
  font-size: 28rpx;
  color: #007aff;
  background-color: #f8f9fa;
  border: 1rpx solid #e9ecef;
  border-radius: 20rpx;
  padding: 15rpx 30rpx;
}

/* 统计弹窗 */
.stats-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.stats-modal.show {
  opacity: 1;
  visibility: visible;
}

.stats-content {
  background: white;
  border-radius: 16rpx;
  width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stats-body {
  padding: 30rpx;
}

.stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.stat-item:last-child {
  border-bottom: none;
}

.stat-label {
  font-size: 28rpx;
  color: #666;
}

.stat-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #007aff;
}