.page {
  padding: 32rpx;
  background: #f5f7fb;
  min-height: 100vh;
  box-sizing: border-box;
}

.intro {
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #738299;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(31, 45, 61, 0.08);
}

.card-header {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2d3d;
  margin-bottom: 20rpx;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.primary-btn,
.secondary-btn {
  width: 100%;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #4f8aff, #6b66ff);
  color: #ffffff;
  border: none;
}

.secondary-btn {
  background: rgba(79, 138, 255, 0.08);
  color: #4f5d78;
  border: none;
}

.secondary-btn.danger {
  background: rgba(255, 118, 118, 0.1);
  color: #ff5353;
}

.video-meta {
  font-size: 26rpx;
  color: #4f5d78;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.preview-video {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #000;
}

.setting-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.label {
  font-size: 26rpx;
  color: #3a4a64;
  font-weight: 500;
}

.progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #4f8aff;
  font-size: 26rpx;
}

.manual-actions {
  display: flex;
  gap: 24rpx;
}

.manual-actions .secondary-btn {
  flex: 1;
}

.hint {
  font-size: 24rpx;
  color: #738299;
  line-height: 1.5;
}

.frame-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 20rpx;
  justify-content: space-between;
}

.frame-card {
  position: relative;
  width: 48%;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(31, 45, 61, 0.1);
  border: 2rpx solid transparent;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.frame-card.selected {
  border-color: #4f8aff;
  box-shadow: 0 12rpx 30rpx rgba(79, 138, 255, 0.3);
  transform: translateY(-4rpx);
}

.frame-image {
  width: 100%;
  height: 200rpx;
  display: block;
}

.frame-info {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  color: #3a4a64;
  background: #f7f9fc;
}

.badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(79, 138, 255, 0.9);
  color: #fff;
}

.badge.manual {
  background: rgba(255, 148, 94, 0.95);
}

.checkmark {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #4f8aff;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-hint {
  padding: 24rpx;
  background: rgba(79, 138, 255, 0.08);
  color: #4f5d78;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.analysis-canvas {
  width: 320px;
  height: 180px;
  position: absolute;
  top: -9999px;
  left: -9999px;
  opacity: 0;
}
