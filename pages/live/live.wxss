/* 直播页面样式 */
.live-container {
  position: relative;
  width: 100%;
  height: 100vh;
  background: #000;
  overflow: hidden;
}

/* 直播区域 */
.live-area {
  position: relative;
  width: 100%;
  height: 100%;
}

.live-pusher,
.live-player {
  width: 100%;
  height: 100%;
}

/* 直播控制层 */
.live-controls {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 20rpx;
  background: linear-gradient(to bottom, rgba(0,0,0,0.6), transparent);
}

.live-info {
  margin-bottom: 20rpx;
}

.live-title {
  display: block;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  text-shadow: 0 1px 3px rgba(0,0,0,0.5);
}

.live-stats {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.viewer-count,
.live-status {
  color: #fff;
  font-size: 24rpx;
  background: rgba(0,0,0,0.3);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.live-status {
  color: #ff4757;
  font-weight: bold;
}

/* 主播控制按钮 */
.host-controls {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.control-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: none;
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
}

.live-btn {
  width: auto;
  padding: 0 30rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.live-btn.start {
  background: #ff4757;
}

.live-btn.stop {
  background: #2ed573;
}

.control-btn.muted {
  background: rgba(255,71,87,0.8);
}

.control-btn.on {
  background: rgba(255,193,7,0.8);
}

/* 弹幕区域 */
.danmaku-area {
  position: absolute;
  top: 200rpx;
  left: 20rpx;
  right: 20rpx;
  bottom: 200rpx;
  z-index: 5;
  pointer-events: none;
}

.danmaku-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  background: rgba(0,0,0,0.5);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(10rpx);
  animation: danmakuSlide 8s linear forwards;
}

@keyframes danmakuSlide {
  0% {
    transform: translateX(100%);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateX(-100%);
    opacity: 0;
  }
}

.danmaku-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.danmaku-user {
  color: #fff;
  font-size: 24rpx;
  margin-right: 10rpx;
  font-weight: bold;
}

.danmaku-content {
  color: #fff;
  font-size: 24rpx;
  flex: 1;
}

/* 底部操作栏 */
.bottom-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 20rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.danmaku-input {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.9);
  border-radius: 30rpx;
  padding: 0 20rpx;
}

.input-field {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  border: none;
  background: transparent;
}

.send-btn {
  width: 100rpx;
  height: 60rpx;
  background: #ff4757;
  color: #fff;
  border: none;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-left: 10rpx;
}

.function-buttons {
  display: flex;
  gap: 15rpx;
}

.func-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: none;
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
}

/* 礼物面板 */
.gift-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  max-height: 60vh;
  z-index: 20;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.panel-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: none;
  background: #f5f5f5;
  color: #666;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gift-list {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
  gap: 20rpx;
}

.gift-item {
  width: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  border-radius: 15rpx;
  background: #f8f9fa;
  transition: all 0.3s;
}

.gift-item:active {
  background: #e9ecef;
  transform: scale(0.95);
}

.gift-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
}

.gift-name {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 5rpx;
}

.gift-value {
  font-size: 20rpx;
  color: #ff4757;
  font-weight: bold;
}

/* 标题输入弹窗 */
.title-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  padding: 30rpx;
}

.title-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 10rpx;
  border: none;
  font-size: 28rpx;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background: #ff4757;
  color: #fff;
}

/* 礼物动画层 */
.gift-animation-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 15;
  pointer-events: none;
}

.gift-animation {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  background: rgba(255,71,87,0.9);
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  animation: giftBounce 3s ease-out forwards;
}

@keyframes giftBounce {
  0% {
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
  }
  20% {
    transform: translate(-50%, -50%) scale(1.2);
    opacity: 1;
  }
  80% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
  }
}

.gift-animation-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 15rpx;
}

.gift-animation-text {
  white-space: nowrap;
}

/* 响应式适配 */
@media screen and (max-width: 750rpx) {
  .live-title {
    font-size: 28rpx;
  }
  
  .control-btn {
    width: 70rpx;
    height: 70rpx;
    font-size: 28rpx;
  }
  
  .live-btn {
    font-size: 24rpx;
    padding: 0 25rpx;
  }
}