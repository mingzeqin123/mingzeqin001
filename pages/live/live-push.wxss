/* 直播推流页面样式 */
.live-push-container {
  position: relative;
  width: 100%;
  height: 100vh;
  background-color: #000;
  overflow: hidden;
}

/* 推流组件 */
.live-pusher {
  width: 100%;
  height: 100%;
}

/* 预览界面 */
.preview-container {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.preview-content {
  text-align: center;
  color: #fff;
  padding: 40rpx;
}

.preview-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
  opacity: 0.8;
}

.preview-text {
  font-size: 36rpx;
  margin-bottom: 60rpx;
  font-weight: 500;
}

/* 直播间设置 */
.room-settings {
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 40rpx;
  backdrop-filter: blur(10px);
}

.setting-item {
  margin-bottom: 30rpx;
}

.setting-item:last-child {
  margin-bottom: 0;
}

.setting-label {
  display: block;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  color: #fff;
}

.setting-input {
  width: 100%;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 0 20rpx;
  color: #fff;
  font-size: 28rpx;
}

.setting-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

.setting-textarea {
  width: 100%;
  min-height: 120rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 20rpx;
  color: #fff;
  font-size: 28rpx;
}

.setting-textarea::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

/* 顶部状态栏 */
.top-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.6), transparent);
}

.live-status {
  display: flex;
  align-items: center;
  background-color: rgba(255, 71, 87, 0.9);
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #fff;
  border-radius: 50%;
  margin-right: 12rpx;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.5; }
  100% { opacity: 1; }
}

.live-text {
  color: #fff;
  font-size: 24rpx;
  margin-right: 16rpx;
}

.live-duration {
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}

.live-stats {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.6);
  padding: 12rpx 16rpx;
  border-radius: 30rpx;
}

.stat-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.stat-value {
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}

/* 底部控制栏 */
.bottom-controls {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
  padding: 40rpx 30rpx 60rpx;
}

.control-buttons {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
}

.control-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: none;
  border: none;
  color: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
  min-width: 120rpx;
  transition: all 0.3s ease;
}

.control-btn.active {
  background-color: rgba(255, 71, 87, 0.8);
}

.control-btn.settings {
  background-color: rgba(255, 255, 255, 0.2);
}

.btn-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.btn-text {
  font-size: 22rpx;
  opacity: 0.9;
}

/* 直播操作按钮 */
.live-actions {
  display: flex;
  justify-content: center;
}

.live-btn {
  width: 200rpx;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
}

.live-btn.start {
  background-color: #ff4757;
  color: #fff;
}

.live-btn.stop {
  background-color: #ff6b7a;
  color: #fff;
}

.live-btn:disabled {
  background-color: #999;
  color: #ccc;
}

/* 聊天区域 */
.chat-container {
  position: absolute;
  right: 20rpx;
  top: 120rpx;
  bottom: 200rpx;
  width: 300rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
  z-index: 5;
}

.chat-container.hide {
  transform: translateX(320rpx);
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.chat-title {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.chat-toggle {
  background: none;
  border: none;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.chat-messages {
  flex: 1;
  padding: 20rpx;
  max-height: 400rpx;
}

.message-item {
  display: flex;
  margin-bottom: 20rpx;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-user {
  display: block;
  color: #fff;
  font-size: 22rpx;
  margin-bottom: 4rpx;
  opacity: 0.8;
}

.message-text {
  display: block;
  color: #fff;
  font-size: 26rpx;
  line-height: 1.4;
  word-break: break-all;
}

.chat-input-wrapper {
  display: flex;
  padding: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.chat-input {
  flex: 1;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  padding: 0 20rpx;
  color: #fff;
  font-size: 24rpx;
  margin-right: 16rpx;
}

.chat-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

.send-btn {
  width: 100rpx;
  height: 60rpx;
  background-color: #007aff;
  color: #fff;
  border: none;
  border-radius: 30rpx;
  font-size: 24rpx;
}

/* 设置面板 */
.settings-panel {
  position: absolute;
  left: 20rpx;
  top: 120rpx;
  bottom: 200rpx;
  width: 400rpx;
  background-color: rgba(0, 0, 0, 0.8);
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
  z-index: 5;
}

.settings-panel.hide {
  transform: translateX(-420rpx);
}

.settings-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.settings-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}

.settings-close {
  background: none;
  border: none;
  color: #fff;
  font-size: 32rpx;
  padding: 8rpx;
}

.settings-content {
  padding: 30rpx;
}

.setting-group {
  margin-bottom: 40rpx;
}

.setting-group:last-child {
  margin-bottom: 0;
}

.setting-name {
  display: block;
  color: #fff;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.setting-slider {
  width: 100%;
}

.filter-list {
  display: flex;
  gap: 16rpx;
  white-space: nowrap;
}

.filter-item {
  padding: 16rpx 32rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  color: #fff;
  font-size: 24rpx;
  white-space: nowrap;
  transition: all 0.3s ease;
}

.filter-item.active {
  background-color: #007aff;
}

/* 触摸遮罩 */
.touch-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}