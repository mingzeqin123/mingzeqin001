/* 观看直播页面样式 */
.live-watch-container {
  position: relative;
  width: 100%;
  height: 100vh;
  background-color: #000;
  overflow: hidden;
}

/* 播放器 */
.live-player {
  width: 100%;
  height: 100%;
}

/* 加载状态 */
.loading-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #000;
  z-index: 10;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top: 4rpx solid #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: #fff;
  font-size: 28rpx;
}

/* 离线状态 */
.offline-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #000;
  z-index: 10;
}

.offline-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.offline-text {
  color: #fff;
  font-size: 32rpx;
  margin-bottom: 40rpx;
}

.refresh-btn {
  background-color: #007aff;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}

/* 顶部信息栏 */
.top-info {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 5;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.8), transparent);
  padding: 20rpx 30rpx;
}

.room-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.anchor-info {
  display: flex;
  align-items: center;
}

.anchor-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #fff;
}

.anchor-details {
  display: flex;
  flex-direction: column;
}

.anchor-name {
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.anchor-level {
  color: #ffa502;
  font-size: 22rpx;
  background-color: rgba(255, 165, 2, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.room-stats {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.6);
  padding: 12rpx 16rpx;
  border-radius: 30rpx;
}

.stat-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.stat-value {
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}

.room-actions {
  display: flex;
  gap: 20rpx;
}

.follow-btn {
  background-color: #ff4757;
  color: #fff;
  border: none;
  border-radius: 30rpx;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
}

.share-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: none;
  border-radius: 30rpx;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
}

/* 弹幕区域 */
.danmaku-container {
  position: absolute;
  top: 200rpx;
  left: 0;
  right: 0;
  height: 400rpx;
  z-index: 3;
  pointer-events: none;
}

.danmaku-item {
  position: absolute;
  right: -200rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  white-space: nowrap;
  animation: danmaku-move 8s linear infinite;
}

@keyframes danmaku-move {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-100vw);
  }
}

/* 底部控制栏 */
.bottom-controls {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 5;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.9), transparent);
  padding: 40rpx 20rpx 60rpx;
}

/* 聊天区域 */
.chat-section {
  margin-bottom: 30rpx;
}

.chat-messages {
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  backdrop-filter: blur(10px);
}

.message-item {
  display: flex;
  margin-bottom: 20rpx;
  align-items: flex-start;
}

.message-item:last-child {
  margin-bottom: 0;
}

/* 普通消息 */
.message-item.text .message-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-user {
  display: block;
  color: #fff;
  font-size: 22rpx;
  margin-bottom: 4rpx;
  opacity: 0.8;
}

.message-text {
  display: block;
  color: #fff;
  font-size: 26rpx;
  line-height: 1.4;
  word-break: break-all;
}

/* 礼物消息 */
.gift-message {
  display: flex;
  align-items: center;
  background-color: rgba(255, 215, 0, 0.2);
  padding: 16rpx 20rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 215, 0, 0.5);
}

.gift-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.gift-text {
  color: #fff;
  font-size: 24rpx;
}

.gift-name {
  font-size: 24rpx;
  font-weight: 500;
  margin-left: 8rpx;
}

/* 系统消息 */
.system-message {
  width: 100%;
  text-align: center;
}

.system-text {
  color: #999;
  font-size: 22rpx;
  background-color: rgba(255, 255, 255, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* 聊天输入 */
.chat-input-wrapper {
  display: flex;
  gap: 16rpx;
}

.chat-input {
  flex: 1;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  padding: 0 24rpx;
  color: #fff;
  font-size: 28rpx;
}

.chat-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

.send-btn {
  width: 120rpx;
  height: 80rpx;
  background-color: #007aff;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 26rpx;
}

/* 功能按钮区 */
.function-buttons {
  display: flex;
  justify-content: space-around;
}

.function-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: none;
  border: none;
  color: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
  min-width: 120rpx;
  transition: all 0.3s ease;
}

.function-btn.active {
  background-color: rgba(255, 71, 87, 0.8);
}

.function-btn.gift {
  background-color: rgba(255, 215, 0, 0.8);
}

.btn-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.btn-text {
  font-size: 22rpx;
  opacity: 0.9;
}

/* 礼物面板 */
.gift-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.9);
  border-radius: 32rpx 32rpx 0 0;
  backdrop-filter: blur(20px);
  transition: all 0.3s ease;
  z-index: 10;
}

.gift-panel.hide {
  transform: translateY(100%);
}

.gift-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 40rpx 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.gift-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 500;
}

.gift-close {
  background: none;
  border: none;
  color: #fff;
  font-size: 32rpx;
  padding: 8rpx;
}

.gift-list {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20rpx;
  padding: 40rpx;
}

.gift-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.gift-item:active {
  transform: scale(0.95);
  background-color: rgba(255, 255, 255, 0.2);
}

.gift-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.gift-name {
  color: #fff;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.gift-price {
  color: #ffa502;
  font-size: 20rpx;
  font-weight: 500;
}

.gift-price.free {
  color: #2ed573;
}

/* 触摸遮罩 */
.touch-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}