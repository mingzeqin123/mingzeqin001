/* 购物车页面样式 */
.cart-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

/* 头部操作栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: #fff;
  border-bottom: 1px solid #eee;
}

.select-all {
  display: flex;
  align-items: center;
}

.select-icon {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  margin-right: 16rpx;
  position: relative;
  background-color: #fff;
}

.select-icon.selected {
  background-color: #ff4444;
  border-color: #ff4444;
}

.select-icon.selected::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 10rpx;
  width: 12rpx;
  height: 20rpx;
  border: 2rpx solid #fff;
  border-top: none;
  border-left: none;
  transform: rotate(45deg);
}

.select-text {
  font-size: 28rpx;
  color: #333;
}

.edit-btn {
  font-size: 28rpx;
  color: #666;
}

/* 购物车列表 */
.cart-scroll {
  flex: 1;
  padding: 20rpx 0;
}

.cart-container {
  padding: 0 32rpx;
}

/* 购物车项 */
.cart-item {
  display: flex;
  align-items: flex-start;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.item-select {
  margin-right: 24rpx;
  padding-top: 20rpx;
}

.item-content {
  flex: 1;
  display: flex;
  position: relative;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background-color: #f5f5f5;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-specs {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.spec-item {
  font-size: 24rpx;
  color: #999;
  background-color: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.price-quantity {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 32rpx;
  color: #ff4444;
  font-weight: 600;
}

/* 数量控制器 */
.quantity-control {
  display: flex;
  align-items: center;
  border: 1px solid #ddd;
  border-radius: 8rpx;
  overflow: hidden;
}

.quantity-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  font-size: 32rpx;
  color: #666;
  user-select: none;
}

.quantity-btn.disabled {
  color: #ccc;
  background-color: #fafafa;
}

.quantity-btn:active {
  background-color: #eee;
}

.quantity-input {
  width: 80rpx;
  height: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  background-color: #fff;
  border: none;
  outline: none;
}

/* 删除按钮 */
.delete-btn {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: #ff4444;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  width: 24rpx;
  height: 24rpx;
  background-color: #fff;
  position: relative;
}

.delete-icon::before,
.delete-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 16rpx;
  height: 2rpx;
  background-color: #ff4444;
  transform-origin: center;
}

.delete-icon::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.delete-icon::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* 空购物车 */
.empty-cart {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.go-shopping-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background-color: #ff4444;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

.go-shopping-btn::after {
  border: none;
}

/* 底部操作栏 */
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background-color: #fff;
  border-top: 1px solid #eee;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.select-all-bottom {
  display: flex;
  align-items: center;
}

/* 结算区域 */
.checkout-section {
  display: flex;
  align-items: center;
}

.total-info {
  margin-right: 32rpx;
}

.total-label {
  font-size: 26rpx;
  color: #666;
}

.total-amount {
  font-size: 36rpx;
  color: #ff4444;
  font-weight: 600;
}

.checkout-btn {
  min-width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

.checkout-btn.active {
  background-color: #ff4444;
  color: #fff;
}

.checkout-btn.disabled {
  background-color: #f5f5f5;
  color: #ccc;
}

.checkout-btn::after {
  border: none;
}

/* 编辑操作 */
.edit-actions {
  display: flex;
  align-items: center;
}

.action-btn {
  min-width: 160rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  border-radius: 32rpx;
  border: none;
  margin-left: 16rpx;
}

.action-btn::after {
  border: none;
}

.favorite-btn {
  background-color: #f5f5f5;
  color: #666;
}

.delete-btn {
  background-color: #ff4444;
  color: #fff;
}

/* 加载状态 */
.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}