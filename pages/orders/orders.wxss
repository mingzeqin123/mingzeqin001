/* 订单列表页面样式 */
.orders-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

/* 状态选项卡 */
.status-tabs {
  background-color: #fff;
  border-bottom: 1px solid #eee;
}

.tabs-scroll {
  white-space: nowrap;
}

.tabs-container {
  display: flex;
  padding: 0 32rpx;
}

.tab-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  height: 88rpx;
  margin-right: 40rpx;
  color: #666;
  font-size: 28rpx;
}

.tab-item.active {
  color: #ff4444;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #ff4444;
  border-radius: 2rpx;
}

.tab-label {
  margin-right: 8rpx;
}

.tab-count {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background-color: #ff4444;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* 订单列表 */
.orders-scroll {
  flex: 1;
  padding: 20rpx 0;
}

.orders-container {
  padding: 0 32rpx;
}

/* 订单项 */
.order-item {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1px solid #f0f0f0;
}

.order-info {
  display: flex;
  flex-direction: column;
}

.order-no {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 28rpx;
  font-weight: 500;
}

.order-status.pending {
  color: #ff4444;
}

.order-status.paid {
  color: #ff8800;
}

.order-status.shipped {
  color: #1890ff;
}

.order-status.delivered {
  color: #52c41a;
}

.order-status.cancelled {
  color: #999;
}

/* 倒计时 */
.countdown {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background-color: #fff2f0;
  border-bottom: 1px solid #f0f0f0;
}

.countdown-text {
  font-size: 24rpx;
  color: #666;
  margin-right: 8rpx;
}

.countdown-time {
  font-size: 24rpx;
  color: #ff4444;
  font-weight: 500;
}

/* 商品列表 */
.order-products {
  padding: 24rpx 32rpx;
}

.product-item {
  display: flex;
  margin-bottom: 24rpx;
}

.product-item:last-child {
  margin-bottom: 0;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 24rpx;
  background-color: #f5f5f5;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-specs {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.spec-item {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
  margin-bottom: 4rpx;
}

.product-price-qty {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 28rpx;
  color: #ff4444;
  font-weight: 500;
}

.product-quantity {
  font-size: 24rpx;
  color: #999;
}

/* 订单金额 */
.order-amount {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 16rpx 32rpx;
  border-top: 1px solid #f0f0f0;
  background-color: #fafafa;
}

.amount-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 8rpx;
}

.amount-value {
  font-size: 32rpx;
  color: #ff4444;
  font-weight: 600;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 24rpx 32rpx;
  border-top: 1px solid #f0f0f0;
}

.action-btn {
  min-width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  border-radius: 32rpx;
  margin-left: 16rpx;
  border: none;
  outline: none;
}

.action-btn::after {
  border: none;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666;
}

.secondary-btn {
  background-color: #f5f5f5;
  color: #666;
}

.primary-btn {
  background-color: #ff4444;
  color: #fff;
}

.pay-btn {
  background-color: #ff4444;
  color: #fff;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx 0;
}

.load-text {
  font-size: 24rpx;
  color: #999;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #ccc;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background-color: #ff4444;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  border: none;
}

.empty-btn::after {
  border: none;
}