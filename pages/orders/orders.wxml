<!--订单列表页面-->
<view class="orders-page">
  <!-- 状态选项卡 -->
  <view class="status-tabs">
    <scroll-view class="tabs-scroll" scroll-x="true">
      <view class="tabs-container">
        <view 
          class="tab-item {{currentTab === index ? 'active' : ''}}"
          wx:for="{{statusTabs}}" 
          wx:key="key"
          data-index="{{index}}"
          bindtap="onTabChange"
        >
          <text class="tab-label">{{item.label}}</text>
          <text class="tab-count" wx:if="{{item.count > 0}}">{{item.count}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 订单列表 -->
  <scroll-view 
    class="orders-scroll" 
    scroll-y="true"
    refresher-enabled="true"
    refresher-triggered="{{loading}}"
    bindrefresherrefresh="onPullDownRefresh"
    bindscrolltolower="onReachBottom"
  >
    <view class="orders-container">
      <!-- 订单项 -->
      <view 
        class="order-item"
        wx:for="{{orders}}" 
        wx:key="id"
        data-order-id="{{item.id}}"
        bindtap="onOrderTap"
      >
        <!-- 订单头部 -->
        <view class="order-header">
          <view class="order-info">
            <text class="order-no">订单号：{{item.orderNo}}</text>
            <text class="order-time">{{formatTime(item.createTime)}}</text>
          </view>
          <view class="order-status {{item.status}}">
            {{item.statusText}}
          </view>
        </view>

        <!-- 倒计时（待付款订单） -->
        <view class="countdown" wx:if="{{item.status === 'pending' && item.expireTime}}">
          <text class="countdown-text">支付剩余时间：</text>
          <text class="countdown-time">{{calculateCountdown(item.expireTime)}}</text>
        </view>

        <!-- 商品列表 -->
        <view class="order-products">
          <view 
            class="product-item"
            wx:for="{{item.items}}" 
            wx:for-item="product"
            wx:key="productId"
          >
            <image class="product-image" src="{{product.productImage}}" mode="aspectFill" />
            <view class="product-info">
              <text class="product-name">{{product.productName}}</text>
              <view class="product-specs" wx:if="{{product.specifications.length > 0}}">
                <text 
                  class="spec-item"
                  wx:for="{{product.specifications}}" 
                  wx:for-item="spec"
                  wx:key="name"
                >
                  {{spec.name}}：{{spec.value}}
                </text>
              </view>
              <view class="product-price-qty">
                <text class="product-price">¥{{product.price}}</text>
                <text class="product-quantity">×{{product.quantity}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 订单金额 -->
        <view class="order-amount">
          <text class="amount-label">实付款：</text>
          <text class="amount-value">¥{{item.finalAmount}}</text>
        </view>

        <!-- 操作按钮 -->
        <view class="order-actions">
          <!-- 待付款状态 -->
          <block wx:if="{{item.status === 'pending'}}">
            <button 
              class="action-btn cancel-btn"
              data-order-id="{{item.id}}"
              data-order-no="{{item.orderNo}}"
              catchtap="onCancelOrder"
            >
              取消订单
            </button>
            <button 
              class="action-btn pay-btn"
              data-order-id="{{item.id}}"
              catchtap="onPayOrder"
            >
              立即支付
            </button>
          </block>

          <!-- 待发货状态 -->
          <block wx:if="{{item.status === 'paid'}}">
            <button class="action-btn secondary-btn" catchtap="onContactService">
              联系客服
            </button>
          </block>

          <!-- 待收货状态 -->
          <block wx:if="{{item.status === 'shipped'}}">
            <button 
              class="action-btn secondary-btn"
              data-order-id="{{item.id}}"
              catchtap="onViewLogistics"
            >
              查看物流
            </button>
            <button 
              class="action-btn primary-btn"
              data-order-id="{{item.id}}"
              data-order-no="{{item.orderNo}}"
              catchtap="onConfirmDelivery"
            >
              确认收货
            </button>
          </block>

          <!-- 已完成状态 -->
          <block wx:if="{{item.status === 'delivered'}}">
            <button 
              class="action-btn secondary-btn"
              data-order-id="{{item.id}}"
              catchtap="onApplyAfterSale"
            >
              申请售后
            </button>
            <button 
              class="action-btn secondary-btn"
              data-order-id="{{item.id}}"
              catchtap="onBuyAgain"
            >
              再次购买
            </button>
          </block>
        </view>
      </view>

      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{hasMore}}">
        <text class="load-text">{{loading ? '加载中...' : '上拉加载更多'}}</text>
      </view>

      <!-- 没有更多数据 -->
      <view class="no-more" wx:if="{{!hasMore && orders.length > 0}}">
        <text class="no-more-text">没有更多订单了</text>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{orders.length === 0 && !loading}}">
        <image class="empty-image" src="/images/empty-orders.png" />
        <text class="empty-text">暂无订单</text>
        <button class="empty-btn" bindtap="onGoShopping">去逛逛</button>
      </view>
    </view>
  </scroll-view>
</view>