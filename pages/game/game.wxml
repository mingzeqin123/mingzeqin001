<!--pages/game/game.wxml-->
<view class="game-container">
  <!-- Game Canvas -->
  <canvas 
    canvas-id="gameCanvas" 
    id="gameCanvas"
    type="webgl"
    class="game-canvas"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
  ></canvas>
  
  <!-- Game UI -->
  <view class="game-ui">
    <!-- Score Display -->
    <view class="score-panel">
      <text class="score-label">Score</text>
      <text class="score-value">{{score}}</text>
    </view>
    
    <!-- Best Score -->
    <view class="best-score-panel">
      <text class="best-score-label">Best Score</text>
      <text class="best-score-value">{{bestScore}}</text>
    </view>
  </view>
  
  <!-- Game Start Screen -->
  <view class="start-screen" wx:if="{{gameState === 'start'}}">
    <view class="game-title">Jump Game</view>
    <view class="game-subtitle">Hold to charge, release to jump</view>
    <button class="start-btn" bindtap="startGame">Start Game</button>
  </view>
  
  <!-- Game Over Screen -->
  <view class="game-over-screen" wx:if="{{gameState === 'over'}}">
    <view class="game-over-title">Game Over</view>
    <view class="final-score">Final Score: {{score}}</view>
    <view class="best-score-display" wx:if="{{isNewRecord}}">🎉 New Record!</view>
    <button class="restart-btn" bindtap="restartGame">Play Again</button>
    <button class="share-btn" bindtap="shareScore">Share Score</button>
  </view>
  
  <!-- Power Indicator -->
  <view class="power-indicator" wx:if="{{gameState === 'playing' && isPressing}}">
    <view class="power-bar">
      <view class="power-fill" style="height: {{power}}%"></view>
    </view>
    <text class="power-text">Charging...</text>
  </view>
  
  <!-- Operation Hint -->
  <view class="hint" wx:if="{{gameState === 'playing' && score === 0}}">
    <text>Hold screen to charge, release to jump</text>
  </view>
</view>