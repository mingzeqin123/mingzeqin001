/* pages/quiz/quiz.wxss */
.quiz-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
}

/* 准备界面 */
.ready-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  color: white;
  text-align: center;
}

.quiz-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.quiz-info {
  margin-bottom: 60rpx;
}

.question-count, .time-limit {
  display: block;
  font-size: 28rpx;
  margin-bottom: 10rpx;
  opacity: 0.9;
}

.quiz-types {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-bottom: 80rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.type-name {
  font-size: 24rpx;
  opacity: 0.9;
}

.start-btn {
  background: white;
  color: #667eea;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

/* 答题界面 */
.quiz-screen {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  min-height: calc(100vh - 40rpx);
}

.quiz-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-info {
  font-size: 28rpx;
  color: #333;
}

.question-number {
  font-weight: bold;
}

.total-questions {
  color: #999;
}

.time-info {
  background: #ff6b6b;
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.progress-bar {
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  transition: width 0.3s ease;
}

.question-content {
  margin-bottom: 40rpx;
}

.question-type {
  background: #667eea;
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  display: inline-block;
  margin-bottom: 20rpx;
}

.question-text {
  font-size: 32rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 30rpx;
}

.options {
  margin-bottom: 30rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 15rpx;
  background: #f8f9fa;
  border-radius: 15rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.option-item.selected {
  background: #e3f2fd;
  border-color: #667eea;
}

.option-item.multiple {
  padding: 15rpx 20rpx;
}

.option-item.truefalse {
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
}

.option-label {
  margin-right: 15rpx;
  font-weight: bold;
  color: #667eea;
  min-width: 40rpx;
}

.option-checkbox {
  margin-right: 15rpx;
  font-size: 24rpx;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.answer-display {
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 15rpx;
  margin-bottom: 30rpx;
}

.answer-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.correct-answer {
  font-size: 28rpx;
  color: #4caf50;
  margin-bottom: 15rpx;
  font-weight: bold;
}

.explanation {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.quiz-actions {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  position: fixed;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
}

.action-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.prev-btn {
  background: #f0f0f0;
  color: #666;
}

.prev-btn:disabled {
  opacity: 0.5;
}

.show-answer-btn {
  background: #ff9800;
  color: white;
}

.next-btn, .submit-btn {
  background: #4caf50;
  color: white;
}

/* 完成界面 */
.completed-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  color: white;
  text-align: center;
}

.result-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 60rpx;
}

.score-display {
  margin-bottom: 60rpx;
}

.score-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.score-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #667eea;
}

.score-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 5rpx;
}

.result-details {
  margin-bottom: 80rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.detail-label {
  opacity: 0.9;
}

.detail-value {
  font-weight: bold;
}

.result-actions {
  display: flex;
  gap: 30rpx;
}

.view-details-btn {
  background: rgba(255, 255, 255, 0.2);
  color: white;
  border: 2rpx solid white;
}

.restart-btn {
  background: white;
  color: #667eea;
}