/* quiz.wxss */
.quiz-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
}

/* 开始页面样式 */
.quiz-start {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.start-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.quiz-info {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 60rpx;
  width: 100%;
  backdrop-filter: blur(10rpx);
}

.info-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  color: white;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 28rpx;
}

.info-value {
  font-size: 28rpx;
  font-weight: bold;
}

.start-btn {
  background: linear-gradient(45deg, #ff6b6b, #ee5a24);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 80rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.3);
}

.history-btn {
  background: rgba(255, 255, 255, 0.2);
  color: white;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  padding: 16rpx 60rpx;
  font-size: 28rpx;
}

/* 答题页面样式 */
.quiz-content {
  background: white;
  border-radius: 20rpx;
  margin: 20rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.progress-bar {
  padding: 30rpx;
  background: #f8f9fa;
  border-bottom: 1rpx solid #e9ecef;
}

.progress-info {
  text-align: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #666;
}

.progress-track {
  height: 8rpx;
  background: #e9ecef;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.question-content {
  padding: 40rpx;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.question-type {
  background: #667eea;
  color: white;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.question-number {
  font-size: 28rpx;
  color: #666;
}

.question-text {
  font-size: 32rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 40rpx;
  font-weight: 500;
}

.options-list {
  margin-bottom: 50rpx;
}

.option-item {
  margin-bottom: 20rpx;
}

.option-single, .option-multiple {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.option-single.selected, .option-multiple.selected {
  border-color: #667eea;
  background: rgba(102, 126, 234, 0.1);
}

.option-radio, .option-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.option-radio {
  border-radius: 50%;
}

.option-checkbox {
  border-radius: 6rpx;
}

.radio-checked {
  width: 20rpx;
  height: 20rpx;
  background: #667eea;
  border-radius: 50%;
}

.checkbox-checked {
  color: #667eea;
  font-size: 24rpx;
  font-weight: bold;
}

.option-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.submit-btn {
  background: linear-gradient(45deg, #667eea, #764ba2);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
  width: 100%;
}

/* 结果页面样式 */
.quiz-result {
  background: white;
  border-radius: 20rpx;
  margin: 20rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.result-header {
  margin-bottom: 50rpx;
}

.result-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.score-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.3);
}

.score-text {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
}

.score-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.result-details {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.detail-item:last-child {
  margin-bottom: 0;
}

.detail-label {
  color: #666;
}

.detail-value {
  font-weight: bold;
  color: #333;
}

.detail-value.correct {
  color: #28a745;
}

.detail-value.wrong {
  color: #dc3545;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #e9ecef;
  background: white;
  color: #666;
}

.action-btn.primary {
  background: linear-gradient(45deg, #667eea, #764ba2);
  color: white;
  border: none;
}