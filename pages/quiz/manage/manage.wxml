<!--pages/quiz/manage/manage.wxml-->
<view class="manage-container">
  <!-- 题目列表 -->
  <view class="question-list" wx:if="{{!showAddForm}}">
    <view class="list-header">
      <text class="list-title">题目管理</text>
      <button class="add-btn" bindtap="showAddQuestion">+ 添加题目</button>
    </view>
    
    <view class="question-items" wx:if="{{questions.length > 0}}">
      <view 
        class="question-item"
        wx:for="{{questions}}"
        wx:key="id"
      >
        <view class="question-info">
          <view class="question-header">
            <text class="question-type">{{getTypeName(item.type)}}</text>
            <text class="question-id">#{{index + 1}}</text>
          </view>
          <text class="question-text">{{item.question}}</text>
          <text class="correct-answer">正确答案：{{formatCorrectAnswer(item)}}</text>
        </view>
        
        <view class="question-actions">
          <button 
            class="action-btn edit-btn" 
            bindtap="editQuestion"
            data-index="{{index}}"
          >
            编辑
          </button>
          <button 
            class="action-btn delete-btn" 
            bindtap="deleteQuestion"
            data-index="{{index}}"
          >
            删除
          </button>
        </view>
      </view>
    </view>
    
    <view class="empty-state" wx:else>
      <text class="empty-icon">📝</text>
      <text class="empty-text">暂无题目</text>
      <button class="add-first-btn" bindtap="showAddQuestion">添加第一道题</button>
    </view>
  </view>

  <!-- 添加/编辑表单 -->
  <view class="add-form" wx:if="{{showAddForm}}">
    <view class="form-header">
      <text class="form-title">{{editingIndex === -1 ? '添加题目' : '编辑题目'}}</text>
      <text class="cancel-btn" bindtap="cancelAdd">取消</text>
    </view>
    
    <view class="form-content">
      <!-- 题目类型 -->
      <view class="form-group">
        <text class="form-label">题目类型</text>
        <picker 
          bindchange="onTypeChange" 
          value="{{newQuestion.type}}" 
          range="['single', 'multiple', 'truefalse']"
          range-key="typeName"
        >
          <view class="picker">
            <text wx:if="{{newQuestion.type === 'single'}}">单选题</text>
            <text wx:elif="{{newQuestion.type === 'multiple'}}">多选题</text>
            <text wx:else>判断题</text>
          </view>
        </picker>
      </view>

      <!-- 题目内容 -->
      <view class="form-group">
        <text class="form-label">题目内容</text>
        <textarea 
          class="form-textarea"
          placeholder="请输入题目内容"
          value="{{newQuestion.question}}"
          bindinput="onQuestionInput"
          maxlength="500"
        ></textarea>
      </view>

      <!-- 选项（单选题和多选题） -->
      <view class="form-group" wx:if="{{newQuestion.type !== 'truefalse'}}">
        <text class="form-label">选项</text>
        <view class="options-list">
          <view 
            class="option-item"
            wx:for="{{newQuestion.options}}"
            wx:key="index"
          >
            <text class="option-label">{{index + 1}}.</text>
            <input 
              class="option-input"
              placeholder="请输入选项内容"
              value="{{item}}"
              bindinput="onOptionInput"
              data-index="{{index}}"
            />
            <radio 
              class="option-radio"
              checked="{{newQuestion.correctAnswer === index}}"
              bindtap="onCorrectAnswerChange"
              data-value="{{index}}"
              wx:if="{{newQuestion.type === 'single'}}"
            />
            <checkbox 
              class="option-checkbox"
              checked="{{newQuestion.correctAnswer.includes(index)}}"
              bindtap="onCorrectAnswerChange"
              data-value="{{index}}"
              wx:if="{{newQuestion.type === 'multiple'}}"
            />
          </view>
        </view>
      </view>

      <!-- 判断题选项 -->
      <view class="form-group" wx:if="{{newQuestion.type === 'truefalse'}}">
        <text class="form-label">正确答案</text>
        <radio-group bindchange="onCorrectAnswerChange">
          <label class="radio-item">
            <radio value="true" checked="{{newQuestion.correctAnswer === true}}" />
            <text>正确</text>
          </label>
          <label class="radio-item">
            <radio value="false" checked="{{newQuestion.correctAnswer === false}}" />
            <text>错误</text>
          </label>
        </radio-group>
      </view>

      <!-- 解析 -->
      <view class="form-group">
        <text class="form-label">题目解析</text>
        <textarea 
          class="form-textarea"
          placeholder="请输入题目解析"
          value="{{newQuestion.explanation}}"
          bindinput="onExplanationInput"
          maxlength="500"
        ></textarea>
      </view>
    </view>
    
    <view class="form-footer">
      <button class="form-btn cancel" bindtap="cancelAdd">取消</button>
      <button class="form-btn save" bindtap="saveQuestion">保存</button>
    </view>
  </view>
</view>