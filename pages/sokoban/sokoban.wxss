/* pages/sokoban/sokoban.wxss */
.container {
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

/* 顶部标题 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 30rpx 0;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 模式切换 */
.mode-switch {
  display: flex;
  background: white;
  border-radius: 20rpx;
  padding: 10rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.mode-btn {
  flex: 1;
  height: 70rpx;
  border-radius: 15rpx;
  background: transparent;
  color: #666;
  font-size: 28rpx;
  border: none;
  transition: all 0.3s;
}

.mode-btn.active {
  background: linear-gradient(45deg, #2196F3, #21CBF3);
  color: white;
  box-shadow: 0 5rpx 15rpx rgba(33, 150, 243, 0.3);
}

/* 图片选择区域 */
.image-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

/* 测试关卡区域 */
.test-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.test-header {
  text-align: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.test-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.test-subtitle {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.puzzle-list {
  max-height: 400rpx;
  margin-bottom: 30rpx;
}

.puzzle-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 15rpx;
  margin-bottom: 15rpx;
  transition: all 0.3s;
}

.puzzle-item.selected {
  border-color: #2196F3;
  background: #E3F2FD;
}

.puzzle-info {
  flex: 1;
}

.puzzle-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.puzzle-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 5rpx;
}

.puzzle-size {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.puzzle-preview {
  width: 80rpx;
  height: 80rpx;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9f9f9;
}

.preview-text {
  font-size: 20rpx;
  color: #999;
}

.test-actions {
  display: flex;
  gap: 20rpx;
}

/* 推箱子渲染器 */
.renderer-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.renderer-header {
  text-align: center;
  margin-bottom: 20rpx;
}

.renderer-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.puzzle-canvas {
  width: 100%;
  height: 400rpx;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  background: #f9f9f9;
}

.image-container {
  width: 100%;
  height: 400rpx;
  border: 2rpx dashed #ddd;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.puzzle-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}

.image-placeholder .iconfont {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.placeholder-text {
  font-size: 28rpx;
}

.image-actions {
  display: flex;
  gap: 20rpx;
}

/* 按钮样式 */
.btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border: none;
  position: relative;
  overflow: hidden;
}

.btn .iconfont {
  margin-right: 10rpx;
  font-size: 32rpx;
}

.btn-primary {
  background: linear-gradient(45deg, #2196F3, #21CBF3);
  color: white;
}

.btn-success {
  background: linear-gradient(45deg, #4CAF50, #8BC34A);
  color: white;
}

.btn-secondary {
  background: linear-gradient(45deg, #757575, #9E9E9E);
  color: white;
}

.btn[disabled] {
  opacity: 0.6;
  pointer-events: none;
}

/* 处理状态 */
.processing-status {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.loading {
  margin-bottom: 20rpx;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #2196F3;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.status-text {
  font-size: 28rpx;
  color: #666;
}

/* 解决方案区域 */
.solution-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.solution-header {
  text-align: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.solution-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #2196F3;
  margin-bottom: 10rpx;
}

.solution-info {
  display: block;
  font-size: 28rpx;
  color: #666;
}

/* 当前步骤 */
.current-step {
  background: linear-gradient(45deg, #E3F2FD, #BBDEFB);
  border-radius: 15rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.step-info {
  display: block;
  font-size: 24rpx;
  color: #1976D2;
  margin-bottom: 10rpx;
}

.step-direction {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #0D47A1;
}

/* 步骤控制 */
.step-controls {
  display: flex;
  gap: 15rpx;
  margin-bottom: 30rpx;
}

.control-btn {
  flex: 1;
  height: 70rpx;
  border-radius: 35rpx;
  background: #f5f5f5;
  color: #333;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.control-btn .iconfont {
  font-size: 28rpx;
  margin: 0 5rpx;
}

.control-btn:not([disabled]):active {
  background: #e0e0e0;
}

.auto-play {
  background: linear-gradient(45deg, #FF9800, #FFC107);
  color: white;
}

/* 进度条 */
.progress-section {
  margin-bottom: 30rpx;
}

.step-slider {
  width: 100%;
}

/* 步骤列表 */
.steps-list {
  margin-bottom: 30rpx;
}

.list-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.steps-scroll {
  max-height: 400rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 10rpx;
}

.step-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s;
}

.step-item:last-child {
  border-bottom: none;
}

.step-item.active {
  background: #E3F2FD;
  color: #1976D2;
}

.step-number {
  width: 60rpx;
  font-weight: bold;
  color: #666;
}

.step-item.active .step-number {
  color: #1976D2;
}

.step-text {
  flex: 1;
  font-size: 26rpx;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
}

/* 使用说明 */
.instructions {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: 30rpx;
}

.instructions-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.instruction-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 15rpx;
}

.instruction-item .number {
  width: 40rpx;
  height: 40rpx;
  background: #2196F3;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.instruction-item .text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 响应式适配 */
@media (max-width: 750rpx) {
  .step-controls {
    flex-direction: column;
  }
  
  .control-btn {
    margin-bottom: 10rpx;
  }
  
  .action-buttons {
    flex-direction: column;
  }
}