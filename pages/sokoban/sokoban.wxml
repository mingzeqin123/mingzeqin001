<!--pages/sokoban/sokoban.wxml-->
<view class="container">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="title">推箱子AI求解器</text>
    <text class="subtitle">上传推箱子图片，AI自动分析并给出最优解</text>
  </view>

  <!-- 模式切换 -->
  <view class="mode-switch">
    <button class="mode-btn {{!showTestMode ? 'active' : ''}}" bindtap="toggleTestMode">
      图片识别模式
    </button>
    <button class="mode-btn {{showTestMode ? 'active' : ''}}" bindtap="toggleTestMode">
      测试关卡模式
    </button>
  </view>

  <!-- 图片选择区域 -->
  <view wx:if="{{!showTestMode}}" class="image-section">
    <view class="image-container" bindtap="chooseImage">
      <image wx:if="{{imageUrl}}" src="{{imageUrl}}" class="puzzle-image" mode="aspectFit"/>
      <view wx:else class="image-placeholder">
        <text class="iconfont icon-image"></text>
        <text class="placeholder-text">点击选择推箱子图片</text>
      </view>
    </view>
    
    <view class="image-actions">
      <button class="btn btn-primary" bindtap="chooseImage">
        <text class="iconfont icon-photo"></text>
        选择图片
      </button>
      <button class="btn btn-success" bindtap="solvePuzzle" disabled="{{!imageUrl || isProcessing}}">
        <text class="iconfont icon-brain"></text>
        {{isProcessing ? '分析中...' : 'AI求解'}}
      </button>
    </view>
  </view>

  <!-- 测试关卡选择 -->
  <view wx:if="{{showTestMode}}" class="test-section">
    <view class="test-header">
      <text class="test-title">选择测试关卡</text>
      <text class="test-subtitle">体验AI求解能力</text>
    </view>
    
    <scroll-view class="puzzle-list" scroll-y="true">
      <view 
        wx:for="{{testPuzzles}}" 
        wx:key="index" 
        class="puzzle-item {{selectedTestPuzzle === index ? 'selected' : ''}}"
        bindtap="selectTestPuzzle"
        data-index="{{index}}"
      >
        <view class="puzzle-info">
          <text class="puzzle-name">{{item.name}}</text>
          <text class="puzzle-desc">{{item.description}}</text>
          <text class="puzzle-size">{{item.rows}}x{{item.cols}} - {{item.grid[0].length}}个箱子</text>
        </view>
        <view class="puzzle-preview">
          <text class="preview-text">预览</text>
        </view>
      </view>
    </scroll-view>
    
    <view class="test-actions">
      <button class="btn btn-primary" bindtap="loadTestPuzzle">
        <text class="iconfont icon-play"></text>
        加载关卡
      </button>
      <button class="btn btn-success" bindtap="solveTestPuzzle" disabled="{{!puzzleGrid || isProcessing}}">
        <text class="iconfont icon-brain"></text>
        {{isProcessing ? '求解中...' : '开始求解'}}
      </button>
    </view>
  </view>

  <!-- 推箱子渲染器 -->
  <view wx:if="{{showRenderer}}" class="renderer-section">
    <view class="renderer-header">
      <text class="renderer-title">推箱子布局</text>
    </view>
    <canvas 
      id="puzzleCanvas" 
      type="2d" 
      class="puzzle-canvas"
    ></canvas>
  </view>

  <!-- 处理状态 -->
  <view wx:if="{{isProcessing}}" class="processing-status">
    <view class="loading">
      <view class="spinner"></view>
    </view>
    <text class="status-text">{{processingStatus}}</text>
  </view>

  <!-- 解决方案显示 -->
  <view wx:if="{{showSolution}}" class="solution-section">
    <view class="solution-header">
      <text class="solution-title">找到最优解！</text>
      <text class="solution-info">总共需要 {{totalSteps}} 步</text>
    </view>

    <!-- 当前步骤显示 -->
    <view class="current-step">
      <text class="step-info">第 {{currentStep + 1}} / {{totalSteps}} 步</text>
      <text class="step-direction">{{solutionSteps[currentStep]}}</text>
    </view>

    <!-- 步骤控制 -->
    <view class="step-controls">
      <button class="control-btn" bindtap="prevStep" disabled="{{currentStep === 0}}">
        <text class="iconfont icon-left"></text>
        上一步
      </button>
      
      <button class="control-btn auto-play" bindtap="autoPlay">
        <text class="iconfont icon-play"></text>
        自动播放
      </button>
      
      <button class="control-btn" bindtap="nextStep" disabled="{{currentStep === totalSteps - 1}}">
        下一步
        <text class="iconfont icon-right"></text>
      </button>
    </view>

    <!-- 步骤进度条 -->
    <view class="progress-section">
      <slider 
        value="{{currentStep}}" 
        max="{{totalSteps - 1}}" 
        step="1" 
        bindchange="goToStep"
        activeColor="#2196F3"
        backgroundColor="#e0e0e0"
        block-size="20"
        class="step-slider"
      />
    </view>

    <!-- 完整步骤列表 -->
    <view class="steps-list">
      <text class="list-title">完整解决步骤：</text>
      <scroll-view class="steps-scroll" scroll-y="true">
        <view 
          wx:for="{{solutionSteps}}" 
          wx:key="index" 
          class="step-item {{index === currentStep ? 'active' : ''}}"
          bindtap="goToStep"
          data-step="{{index}}"
        >
          <text class="step-number">{{index + 1}}.</text>
          <text class="step-text">{{item}}</text>
        </view>
      </scroll-view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button class="btn btn-secondary" bindtap="reset">
        <text class="iconfont icon-refresh"></text>
        重新开始
      </button>
      <button class="btn btn-primary" bindtap="shareResult">
        <text class="iconfont icon-share"></text>
        分享结果
      </button>
    </view>
  </view>

  <!-- 使用说明 -->
  <view class="instructions">
    <text class="instructions-title">使用说明：</text>
    <view class="instruction-item">
      <text class="number">1.</text>
      <text class="text">拍摄或选择清晰的推箱子游戏截图</text>
    </view>
    <view class="instruction-item">
      <text class="number">2.</text>
      <text class="text">确保图片包含完整的游戏界面和所有元素</text>
    </view>
    <view class="instruction-item">
      <text class="number">3.</text>
      <text class="text">点击"AI求解"开始自动分析和求解</text>
    </view>
    <view class="instruction-item">
      <text class="number">4.</text>
      <text class="text">查看最优解决方案的详细步骤</text>
    </view>
  </view>
</view>