/* pages/sonos/sonos.wxss */
.sonos-container {
  padding: 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.status-section {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  backdrop-filter: blur(10rpx);
}

.status-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.status-item:last-child {
  margin-bottom: 0;
}

.status-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.status-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
}

.status-value.connected {
  color: #4CAF50;
}

.status-value.disconnected {
  color: #f44336;
}

.config-section,
.device-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
  text-align: center;
}

.input-group {
  margin-bottom: 30rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 15rpx;
}

.input-field {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #667eea;
  background: #ffffff;
}

.picker {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.picker-text {
  font-size: 28rpx;
  color: #333333;
}

.btn {
  width: 100%;
  height: 80rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  transition: all 0.3s ease;
}

.btn:last-child {
  margin-bottom: 0;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border: none;
}

.btn-primary:disabled {
  background: #cccccc;
  color: #666666;
}

.btn-secondary {
  background: #4CAF50;
  color: #ffffff;
  border: none;
}

.btn-help {
  background: #2196F3;
  color: #ffffff;
  border: none;
}

.btn-danger {
  background: #f44336;
  color: #ffffff;
  border: none;
}

.btn-success {
  background: #4CAF50;
  color: #ffffff;
  border: none;
}

.action-section {
  margin-bottom: 40rpx;
}

.help-section {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  backdrop-filter: blur(10rpx);
}

.help-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
  text-align: center;
}

.help-content {
  display: flex;
  flex-direction: column;
}

.help-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.help-text:last-child {
  margin-bottom: 0;
}