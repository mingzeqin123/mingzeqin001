<!--pages/sonos/sonos.wxml-->
<view class="sonos-container">
  <view class="header">
    <text class="title">Sonos 音频配置</text>
    <text class="subtitle">连接您的Sonos设备，享受更好的游戏体验</text>
  </view>

  <!-- 连接状态 -->
  <view class="status-section">
    <view class="status-item">
      <text class="status-label">连接状态：</text>
      <text class="status-value {{connectionStatus}}">
        {{connectionStatus === 'connected' ? '已连接' : '未连接'}}
      </text>
    </view>
    <view class="status-item" wx:if="{{config.isInitialized}}">
      <text class="status-label">播放器数量：</text>
      <text class="status-value">{{config.playersCount}}</text>
    </view>
  </view>

  <!-- API配置 -->
  <view class="config-section">
    <view class="section-title">API 配置</view>
    
    <view class="input-group">
      <text class="input-label">API Key</text>
      <input 
        class="input-field" 
        placeholder="请输入Sonos API Key"
        value="{{apiKey}}"
        bindinput="onApiKeyInput"
        disabled="{{isConfigured}}"
      />
    </view>

    <view class="input-group">
      <text class="input-label">API Secret</text>
      <input 
        class="input-field" 
        placeholder="请输入Sonos API Secret"
        value="{{apiSecret}}"
        bindinput="onApiSecretInput"
        password="{{true}}"
        disabled="{{isConfigured}}"
      />
    </view>

    <button 
      class="btn btn-primary" 
      bindtap="connectSonos"
      disabled="{{isConfigured}}"
    >
      {{isConfigured ? '已配置' : '连接Sonos'}}
    </button>
  </view>

  <!-- 设备选择 -->
  <view class="device-section" wx:if="{{connectionStatus === 'connected'}}">
    <view class="section-title">设备选择</view>
    
    <view class="input-group">
      <text class="input-label">选择家庭</text>
      <picker 
        class="picker" 
        bindchange="onHouseholdChange" 
        value="{{selectedHousehold}}"
        range="{{households}}"
        range-key="name"
      >
        <view class="picker-text">
          {{selectedHousehold ? households[selectedHousehold].name : '请选择家庭'}}
        </view>
      </picker>
    </view>

    <view class="input-group">
      <text class="input-label">选择播放器</text>
      <picker 
        class="picker" 
        bindchange="onPlayerChange" 
        value="{{selectedPlayer}}"
        range="{{players}}"
        range-key="name"
      >
        <view class="picker-text">
          {{selectedPlayer ? players[selectedPlayer].name : '请选择播放器'}}
        </view>
      </picker>
    </view>

    <button class="btn btn-secondary" bindtap="testConnection">
      测试连接
    </button>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <button class="btn btn-help" bindtap="showHelp">
      获取帮助
    </button>
    
    <button 
      class="btn btn-danger" 
      bindtap="disconnect"
      wx:if="{{connectionStatus === 'connected'}}"
    >
      断开连接
    </button>
    
    <button class="btn btn-success" bindtap="backToGame">
      返回游戏
    </button>
  </view>

  <!-- 配置说明 -->
  <view class="help-section">
    <view class="help-title">配置说明</view>
    <view class="help-content">
      <text class="help-text">1. 访问 Sonos 开发者网站注册账号</text>
      <text class="help-text">2. 创建 Control Integration 获取 API 密钥</text>
      <text class="help-text">3. 确保手机和 Sonos 设备在同一网络</text>
      <text class="help-text">4. 填写 API 密钥并测试连接</text>
    </view>
  </view>
</view>