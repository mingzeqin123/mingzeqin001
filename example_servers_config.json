        "disk_critical": 95
      }
    },
    "db-server-01": {
      "name": "数据库服务器01",
      "host": "192.168.1.101",
      "port": 5000,
      "enabled": true,
      "description": "主数据库服务器",
      "tags": [
        "database",
        "production"
      ],
      "thresholds": {
        "cpu_warning": 60,
        "cpu_critical": 85,
        "memory_warning": 75,
        "memory_critical": 90,
        "disk_warning": 70,
        "disk_critical": 90
      }
    },
    "cache-server-01": {
      "name": "缓存服务器01",
      "host": "192.168.1.102",
      "port": 5000,
      "enabled": true,
      "description": "Redis缓存服务器",
      "tags": [
        "cache",
        "production"
      ],
      "thresholds": {
        "cpu_warning": 80,
        "cpu_critical": 95,
        "memory_warning": 85,
