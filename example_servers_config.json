{
  "servers": {
    "web-server-01": {
      "name": "Web服务器01",
      "host": "192.168.1.100",
      "port": 5000,
      "enabled": true,
      "description": "主要的Web服务器",
      "tags": [
        "web",
        "production"
      ],
      "thresholds": {
        "cpu_warning": 70,
