# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coupon_system
DB_USER=root
DB_PASSWORD=password

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=24h

# 服务器配置
PORT=3000
NODE_ENV=development

# 支付配置（示例）
PAYMENT_GATEWAY_URL=https://api.payment-provider.com
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_SECRET_KEY=your-payment-secret-key

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log

# 优惠券配置
DEFAULT_COUPON_VALIDITY_DAYS=30
MAX_COUPONS_PER_USER=10
COUPON_CODE_LENGTH=12