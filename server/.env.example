# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
MONGODB_URI=mongodb://localhost:27017/live-streaming
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置
JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key

# 微信小程序配置
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# 网易云推流配置
NETEASE_APP_KEY=your-netease-app-key
NETEASE_APP_SECRET=your-netease-app-secret
NETEASE_BASE_URL=https://vcloud.163.com

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# 直播配置
MAX_VIEWERS_PER_ROOM=10000
MAX_DANMAKU_LENGTH=50
MAX_DANMAKU_COUNT=1000

# 安全配置
CORS_ORIGIN=*
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100